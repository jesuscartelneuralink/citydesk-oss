{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build && mkdir -p .vercel/output/functions/__server.func/_libs && (cp -f node_modules/@electric-sql/pglite/dist/pglite.data node_modules/@electric-sql/pglite/dist/pglite.wasm node_modules/@electric-sql/pglite/dist/initdb.wasm .vercel/output/functions/__server.func/_libs/ 2>/dev/null || true) && npm run db:migrate",
    "db:migrate": "node scripts/migrate.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "check:auth": "node scripts/check-auth-invariant.mjs",
    "test": "node --test 'scripts/**/*.test.mjs'; S=$?; node --experimental-strip-types --test src/lib/app-data/app-data.test.ts src/lib/app-data/readiness-schedule.test.ts src/lib/auth/gate-identity.test.ts src/lib/auth/sign-in-gate.test.ts src/lib/auth/sessions/sessions.test.ts src/world/workverse/receptionSummary.test.ts; T=$?; echo \"scripts=$S src=$T\"; [ $S -eq 0 ] && [ $T -eq 0 ]",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e:phone": "node scripts/e2e/phone-smoke.mjs",
    "test:immerse": "node --experimental-strip-types --test src/world/immerse/immerse.test.ts",
    "test:sessions": "node --experimental-strip-types --test src/lib/auth/sessions/sessions.test.ts && node --experimental-transform-types --no-warnings --import ./tests/property/register.mjs --test 'tests/sessions/**/*.test.ts'",
    "test:life": "node --experimental-strip-types --test src/world/life/life.test.ts",
    "test:ground": "node --experimental-strip-types --test src/world/ground/ground.test.ts",
    "test:ingest": "node --experimental-strip-types --test src/lib/ingest/*.test.ts && node --test scripts/scan/cleanup.test.mjs scripts/scan/pipeline.test.mjs",
    "test:assistant": "node --experimental-strip-types --test src/world/assistant/assistant.test.ts",
    "test:search": "node --experimental-strip-types --test src/world/search/search.test.ts",
    "test:realism": "node --experimental-strip-types --test src/world/realism/sun.test.ts src/world/realism/heights.test.ts",
    "test:kids": "node --experimental-strip-types --test src/world/kids/kids.test.ts",
    "test:inspect": "node --experimental-strip-types --test src/world/inspect/inspect.test.ts src/world/inspect/inspect.privacy.test.ts",
    "test:props": "node --experimental-strip-types --test 'src/world/props/*.test.ts'",
    "test:collide": "node --experimental-strip-types --test src/world/collide/*.test.ts src/world/empty-state/footprint.test.ts",
    "test:fp": "node --experimental-strip-types --test src/world/fp/fp.test.ts src/world/orbit/cameraOwner.test.ts src/world/audio/spatial.test.ts",
    "test:xr": "node --experimental-strip-types --test src/world/xr/xr.test.ts",
    "test:colony": "node --experimental-strip-types --test src/world/colony/*.test.ts && node --test scripts/colony/no-keys.test.mjs && node --experimental-transform-types --no-warnings --import ./tests/property/register.mjs --test tests/colony/*.test.ts",
    "test:gates": "node --experimental-strip-types --test src/world/gates/*.test.ts",
    "check:flags": "node scripts/check-flags.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@hookform/resolvers": "^5.7.0",
    "@huggingface/transformers": "^4.3.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.2.0",
    "@wallet-standard/app": "^1.1.1",
    "better-auth": "~1.6.30",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.0.0",
    "draco3dgltf": "^1.5.7",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jose": "6.2.9",
    "kysely": "^0.28.5",
    "leaflet": "^1.9.4",
    "lightningcss": "^1.28.0",
    "lucide-react": "^0.510.0",
    "maplibre-gl": "^5.6.1",
    "meshoptimizer": "^1.3.0",
    "nitro": "3.0.260610-beta",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.13.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.3.4",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vite": "^8.2.0",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.56.1"
  }
}